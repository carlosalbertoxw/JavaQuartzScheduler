<!--
  Configuracion de WinSW (https://github.com/winsw/winsw) para ejecutar la aplicacion
  como servicio de Windows. Copia junto al jar el ejecutable de WinSW renombrado como
  JavaQuartzScheduler.exe y este archivo, y ejecuta: JavaQuartzScheduler.exe install
-->
<service>
  <id>JavaQuartzScheduler</id>
  <name>JavaQuartzScheduler</name>
  <description>Rutinas programadas con Quartz Scheduler.</description>

  <executable>java</executable>
  <arguments>-jar "%BASE%\JavaQuartzScheduler-3.0-shaded.jar"</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <startmode>Automatic</startmode>

  <!-- Al detener el servicio WinSW envia Ctrl+C: el hook de apagado espera a las rutinas en curso -->
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="10 sec"/>

  <!-- La aplicacion ya escribe sus logs en logs/; aqui solo se guarda la salida del proceso -->
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>3</keepFiles>
  </log>
</service>
