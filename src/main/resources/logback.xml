<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Carpeta de logs: -Dlog.dir=/ruta si se indica, si no ./logs junto al jar
         (tambien al ejecutarse como servicio). -->
    <define name="LOG_DIR" class="com.carlosalbertoxw.jqs.LogDirPropertyDefiner"/>

    <!-- Salida por consola -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{1}:%line - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Salida a archivo con rotacion diaria y por tamano -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/application.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{1}:%line - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Quartz es bastante verboso en INFO durante el arranque. En WARN tambien se
         omite su aviso "Job ... threw a JobExecutionException", que RoutineJob ya registra. -->
    <logger name="org.quartz" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
